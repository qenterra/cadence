    "Cadence kept the last confirmed library state.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence сохранил последнее подтверждённое состояние медиатеки."
          }
        }
      }
    },
    "Cadence needs permission to access the library again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence снова требуется разрешение на доступ к медиатеке."
          }
        }
      }
    },
    "Cadence will install stable releases only.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence будет устанавливать только стабильные версии."
          }
        }
      }
    },
    "Cadence will never merge with or overwrite an existing library folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence никогда не объединит и не перезапишет существующую папку медиатеки."
          }
        }
      }
    },
    "Cadence will offer stable and beta releases. Beta builds may be less reliable.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadence будет предлагать стабильные и бета-версии. Бета-сборки могут быть менее надёжными."
          }
        }
      }
    },
    "Cadence will scan a preview before anything is imported.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед импортом Cadence сначала покажет результаты сканирования."
          }
        }
      }
    },
