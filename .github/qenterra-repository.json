{
  "$schema": "./qenterra-repository.schema.json",
  "allowed_root_paths": [
    ".periphery-baseline.json",
    ".swiftformat",
    ".swiftlint.yml",
    "Brewfile",
    "Cadence.xcodeproj",
    "Sources",
    "Tests",
    "appcast.xml",
    "icon",
    "project.yml",
    "release",
    "release-contract.json",
    "requirements-dev.txt",
    "scripts"
  ],
  "branch_prefix": "qenterra/",
  "code_owner": "@qenterra",
  "collaboration_model": "solo",
  "conduct_contact": "https://github.com/QenTerra/cadence/security/advisories/new",
  "copyright_holder": "Nikita Melnychenko (QenTerra)",
  "copyright_year_range": "2026",
  "current_version": "0.2.0-beta.1",
  "default_branch": "main",
  "dependabot_ecosystem": "swift",
  "description": "A native macOS music player with a managed local library, lyrics, metadata tools, and private-by-default playback.",
  "documentation_root": "docs",
  "ecosystem": "swift-macos",
  "exceptions": [],
  "github_features": {
    "discussions": false,
    "issues": true,
    "projects": false,
    "wiki": true
  },
  "github_owner": "QenTerra",
  "governance": {
    "generator": "Noetic QenTerra repository templates",
    "required_files": [
      ".github/qenterra-repository.json",
      "CHANGELOG.md",
      "SECURITY.md",
      "GOVERNANCE.md",
      "MAINTAINERS.md",
      "AUTHORS.md",
      "THIRD_PARTY_NOTICES.md",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/release.yml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".github/qenterra-repository.schema.json",
      ".github/workflows/repository-governance.yml",
      "scripts/qenterra_repository_check.py",
      "docs/README.md",
      "docs/ARCHITECTURE.md",
      "docs/DEVELOPMENT.md",
      "docs/TESTING.md",
      "docs/RELEASING.md",
      "docs/DEPENDENCIES.md",
      "docs/STYLE_GUIDE.md",
      "docs/TROUBLESHOOTING.md",
      "docs/GITHUB_SETTINGS.md",
      "docs/MAINTENANCE.md",
      "docs/decisions/README.md",
      "docs/decisions/0000-template.md",
      ".github/dependabot.yml",
      "CONTRIBUTING.md",
      "CODE_OF_CONDUCT.md",
      "SUPPORT.md",
      ".github/ISSUE_TEMPLATE/01-bug.yml",
      ".github/ISSUE_TEMPLATE/02-feature.yml",
      ".github/ISSUE_TEMPLATE/03-documentation.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/labels.yml",
      "README.md",
      "docs/UPDATES.md",
      "docs/wiki/Home.md",
      "docs/wiki/_Sidebar.md",
      "docs/wiki/_Footer.md",
      "docs/wiki/Getting-Started.md",
      "docs/wiki/Architecture.md",
      "docs/wiki/Development.md",
      "docs/wiki/Release-Process.md",
      "docs/wiki/Troubleshooting.md",
      "PRIVACY.md",
      "TERMS_OF_USE.md",
      "LICENSE"
    ],
    "standard_version": "1.3.0"
  },
  "homepage_url": "https://github.com/QenTerra/cadence",
  "install_command": "bash scripts/verify.sh",
  "license": "MIT",
  "merge_strategy": "squash",
  "minimum_requirements": "Apple silicon Mac with macOS 26 or later for use; full Xcode and the declared development tools for source verification.",
  "overlays": ["github-wiki", "product-legal"],
  "primary_language": "English",
  "profile": "application",
  "project_name": "Cadence",
  "published_artifacts": [],
  "quick_start_command": "bash scripts/verify.sh",
  "release_mode": "github-releases",
  "repository_name": "cadence",
  "repository_url": "https://github.com/QenTerra/cadence",
  "security_url": "https://github.com/QenTerra/cadence/security/advisories/new",
  "standard_version": "1.3.0",
  "support_url": "https://github.com/QenTerra/cadence/issues",
  "topics": [
    "qenterra",
    "macos",
    "swift",
    "swiftui",
    "music-player",
    "local-library",
    "local-first",
    "lyrics"
  ],
  "verification_command": "bash scripts/verify.sh",
  "version_scheme": "semver",
  "version_source": "release-contract.json",
  "version_tag_prefix": "v",
  "visibility": "public",
  "wiki_source": "docs/wiki"
}
